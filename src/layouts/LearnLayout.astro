---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface TocItem {
  id: string;
  label: string;
}

interface RelatedGuide {
  href: string;
  kicker: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  toc: TocItem[];
  related: RelatedGuide[];
  schemaType?: "Article" | "AboutPage";
}

const {
  title,
  description,
  eyebrow,
  heading,
  intro,
  toc,
  related,
  schemaType = "Article",
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const pageEntity = schemaType === "AboutPage"
  ? {
      "@type": "AboutPage",
      "@id": canonicalURL ? `${canonicalURL}#page` : undefined,
      url: canonicalURL,
      name: title,
      description,
      mainEntity: {
        "@type": "WebSite",
        "@id": "https://swiss-german.app/#website",
        name: "Swiss German",
        url: "https://swiss-german.app/",
      },
    }
  : {
      "@type": "Article",
      "@id": canonicalURL ? `${canonicalURL}#article` : undefined,
      url: canonicalURL,
      headline: heading,
      description,
      inLanguage: "en",
      dateModified: "2026-08-26",
      author: {
        "@type": "Person",
        name: "Yusef Habib",
        url: "https://yusefhabib.com",
      },
      publisher: {
        "@type": "Organization",
        "@id": "https://swiss-german.app/#organization",
        name: "Swiss German",
        url: "https://swiss-german.app/",
      },
    };

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    pageEntity,
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Swiss German",
          item: "https://swiss-german.app/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: heading,
          item: canonicalURL,
        },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <SiteHeader />

  <main id="main-content" class="learn-page" tabindex="-1">
    <header class="learn-hero section-shell">
      <div class="learn-hero-route" aria-hidden="true">
        <span></span>
        <i></i>
        <b></b>
      </div>
      <p class="eyebrow reveal reveal-1">{eyebrow}</p>
      <h1 class="reveal reveal-2">{heading}</h1>
      <p class="learn-intro reveal reveal-3">{intro}</p>
      <div class="learn-meta reveal reveal-4">
        <span>Swiss German guide</span>
        <span>Updated August 2026</span>
      </div>
    </header>

    <div class="learn-grid section-shell">
      <aside class="learn-toc" aria-label="On this page">
        <p>On this page</p>
        <ol>
          {toc.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <a href={`#${item.id}`}>{item.label}</a>
            </li>
          ))}
        </ol>
      </aside>

      <article class="learn-content">
        <slot />
      </article>
    </div>

    <section class="related-guides section-shell" aria-labelledby="related-guides-title">
      <div class="related-guides-heading">
        <p class="eyebrow">Continue the route</p>
        <h2 id="related-guides-title">Learn the next useful thing.</h2>
      </div>
      <div class="related-guides-grid">
        {related.map((guide, index) => (
          <a href={guide.href} class="related-guide">
            <span>{String(index + 1).padStart(2, "0")} · {guide.kicker}</span>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>
