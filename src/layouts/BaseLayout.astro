---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "/og.png" } = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const imageURL = Astro.site ? new URL(image, Astro.site) : undefined;
const appStoreID = import.meta.env.PUBLIC_APP_STORE_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#F5F3EE" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {appStoreID && (
      <meta name="apple-itunes-app" content={`app-id=${appStoreID}`} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Swiss German" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {imageURL && <meta property="og:image" content={imageURL} />}
    <meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@yhabibf" />
    {imageURL && <meta name="twitter:image" content={imageURL} />}

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
