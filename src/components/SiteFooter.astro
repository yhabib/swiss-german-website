    </div>
  </div>

  <div class="footer-links">
    <a href="/learn-swiss-german/">Learn</a>
    <a href="/swiss-german-phrases/">Phrases</a>
    <a href="/about/">About</a>
    <a href="/privacy">Privacy</a>
    <a href="/support">Support</a>
    <a
      class="founder-link"
      href="https://x.com/yhabibf"
      target="_blank"
      rel="me noopener noreferrer"
      aria-label="Built by Yusef Habib — follow the journey on X (opens in a new tab)"
