---
import LearnLayout from "../layouts/LearnLayout.astro";

const related = [
  {
    href: "/phrases/ich-haett-gaern/",
    kicker: "Phrase focus",
    title: "How to use “I hätt gärn”",
    description: "Build polite requests for cafés, bakeries, restaurants, and shops.",
  },
  {
    href: "/swiss-german-vs-high-german/",
    kicker: "Comparison",
    title: "Swiss German and High German",
    description: "Compare everyday Zürichdeutsch with the Standard German you already recognize.",
  },
  {
    href: "/learn-swiss-german/",
    kicker: "Learning route",
    title: "Turn useful phrases into recall",
    description: "Use a small daily routine to produce Swiss German instead of only recognizing it.",
  },
];

const phraseGroups = [
  {
    id: "greetings",
    number: "01",
    eyebrow: "Arrive well",
    title: "Greetings and goodbyes",
    phrases: [
      ["Grüezi, i hätt e churzi frag.", "Guten Tag, ich hätte eine kurze Frage.", "Hello, I have a quick question."],
      ["Merci vilmal, das hilft würkli.", "Vielen Dank, das hilft sehr.", "Thank you very much, that really helps."],
      ["Kei problem, alles guet.", "Kein Problem, alles gut.", "No problem, everything is fine."],
      ["Bis spöter.", "Bis später.", "See you later."],
    ],
  },
  {
    id: "cafe",
    number: "02",
    eyebrow: "Order naturally",
    title: "Cafés and restaurants",
    phrases: [
      ["I hätt gärn en flat white, bitte.", "Ich hätte gerne einen Flat White, bitte.", "I would like a flat white, please."],
      ["Chan i dezue no es glas wasser ha?", "Kann ich dazu noch ein Glas Wasser haben?", "Can I also have a glass of water?"],
      ["Stimmt so, merci vilmal.", "Stimmt so, danke vielmals.", "Keep the change, thank you very much."],
      ["Für underwägs, bitte.", "Für unterwegs, bitte.", "To take away, please."],
    ],
  },
  {
    id: "understanding",
    number: "03",
    eyebrow: "Stay in the conversation",
    title: "Understanding and clarification",
    phrases: [
      ["I verstah das nöd.", "Ich verstehe das nicht.", "I do not understand that."],
      ["Chasch das bitte langsamer säge?", "Kannst du das bitte langsamer sagen?", "Can you please say that more slowly?"],
      ["Chasch das bitte no einisch wiederhole?", "Kannst du das noch einmal wiederholen?", "Can you please repeat that?"],
      ["Wie seit me das uf Schwiizerdütsch?", "Wie sagt man das auf Schweizerdeutsch?", "How do you say that in Swiss German?"],
    ],
  },
  {
    id: "moving",
    number: "04",
    eyebrow: "Move through Zürich",
    title: "Tram, train, and directions",
    phrases: [
      ["Vo welem gleis fahrt de zug ab?", "Von welchem Gleis fährt der Zug ab?", "Which platform does the train leave from?"],
      ["Isch das de direkt zug nach winterthur?", "Ist das der direkte Zug nach Winterthur?", "Is this the direct train to Winterthur?"],
      ["Mir müend am hauptbahnhof umstiege.", "Wir müssen am Hauptbahnhof umsteigen.", "We must change at the main station."],
      ["Wie chum i zum nachtbus?", "Wie komme ich zum Nachtbus?", "How do I get to the night bus?"],
    ],
  },
];
---

<LearnLayout
  title="Swiss German Phrases for Everyday Life in Zürich"
  description="Learn practical Swiss German phrases in readable Zürichdeutsch, with Standard German and English meanings for daily life in Zürich."
  eyebrow="16 phrases · Four daily situations"
  heading="Swiss German phrases for real life."
  intro="Start with complete phrases you can use in Zürich. Each phrase includes Standard German and English, so meaning never becomes a guessing exercise."
  toc={phraseGroups.map((group) => ({ id: group.id, label: group.title }))}
  related={related}
>
  {phraseGroups.map((group) => (
    <section id={group.id} class="learn-section phrasebook-section">
      <span class="section-number">{group.number}</span>
      <div>
        <p class="eyebrow">{group.eyebrow}</p>
        <h2>{group.title}</h2>
        <div class="phrase-table" role="table" aria-label={group.title}>
          <div class="phrase-table-head" role="row">
            <span role="columnheader">Zürichdeutsch</span>
            <span role="columnheader">Standard German</span>
            <span role="columnheader">English</span>
          </div>
          {group.phrases.map((phrase) => (
            <div class="phrase-table-row" role="row">
              <strong role="cell" lang="gsw">{phrase[0]}</strong>
              <span role="cell" lang="de">{phrase[1]}</span>
              <span role="cell">{phrase[2]}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="learn-section">
    <span class="section-number">05</span>
    <div>
      <p class="eyebrow">Practice, not decoration</p>
      <h2>Use one phrase in one real moment.</h2>
      <p>
        Choose one phrase before you leave home. Recall it once without looking, then use it when the situation appears.
      </p>
      <div class="learn-callout">
        <span>Good first choice</span>
        <p><b lang="gsw">I hätt gärn en flat white, bitte.</b> One useful frame can produce many new requests.</p>
        <a href="/phrases/ich-haett-gaern/">Learn the complete phrase pattern →</a>
      </div>
    </div>
  </section>
</LearnLayout>
